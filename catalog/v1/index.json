      "manifest": {
        "schemaVersion": 1,
        "format": "compiled",
        "id": "lexora.auto-title",
        "name": "标题自动生成",
        "author": "Lexora",
        "description": "根据首条有效输入自动生成任务标题，保留手动命名，也可随任务目标变化更新。",
        "icon": "icon.svg",
        "categories": [
          "效率"
        ],
        "tags": [
          "任务标题",
          "自动命名",
          "AI"
        ],
        "version": "1.2.2",
        "apiVersion": 3,
        "engines": {
          "lexora": ">=0.9.4 <1.0.0"
        },
        "entry": "extension.js",
        "dataVersion": 1,
        "dependencies": {},
        "permissions": {
          "agent": true,
          "models": true,
          "tasks": "title",
          "taskMessages": true,
          "windowEffects": false,
          "controls": [],
          "notifications": false,
          "schedules": false,
          "selectedResource": "none",
          "selectedContent": false,
          "localResources": false,
          "resourceExport": false,
          "themeManagement": false,
          "network": []
        },
        "contributes": {
          "themes": [],
          "conditions": [
            {
              "id": "lexora.auto-title.available",
              "inputs": [
                "configuration",
                "form"
              ]
            },
            {
              "id": "lexora.auto-title.runnable",
              "inputs": [
                "configuration",
                "runtime.models",
                "runtime.task"
              ]
            }
          ],
          "agent": {
            "enabledWhen": "enabled",
            "instructions": "",
            "tools": [],
            "actions": [
              {
                "enabledWhen": {
                  "condition": "lexora.auto-title.runnable",
                  "params": {}
                },
                "id": "lexora.auto-title.generate",
                "title": "重新生成标题",
                "triggers": [
                  "task:input:committed",
                  "task:turn:completed"
                ]
              }
            ]
          },
          "settings": {
            "modules": [],
            "groups": [
              {
                "id": "lexora.auto-title.naming",
                "module": "settings.runtime",
                "title": "标题自动生成",
                "order": 0
              }
            ],
            "items": [
              {
                "id": "lexora.auto-title.enabled",
                "key": "enabled",
                "group": "lexora.auto-title.naming",
                "title": "启用",
                "description": "提交输入后在后台生成一次标题，会额外调用模型；内容不足或失败后可在下次输入时重试。",
                "order": 0,
                "type": "boolean",
                "default": true
              },
              {
                "enabledWhen": {
                  "condition": "lexora.auto-title.available",
                  "params": {
                    "purpose": "configure"
                  }
                },
                "id": "lexora.auto-title.model",
                "key": "model",
                "group": "lexora.auto-title.naming",
                "title": "生成标题的模型",
                "description": "留空使用触发任务当前选择的模型。",
                "order": 1,
                "type": "model",
                "default": null
              },
              {
                "enabledWhen": {
                  "condition": "lexora.auto-title.available",
                  "params": {
                    "purpose": "configure"
                  }
                },
                "id": "lexora.auto-title.update-on-goal-change",
                "key": "updateOnGoalChange",
                "group": "lexora.auto-title.naming",
                "title": "允许随任务目标更新",
                "description": "每轮回答后额外调用模型评估，仅在任务目标明显变化时更新自动标题。手动标题始终保留。",
                "order": 2,
                "type": "boolean",
                "default": false
              }
            ]
          },
          "commands": [],
          "menus": [],
          "views": [],
          "placements": []
        }
      },
